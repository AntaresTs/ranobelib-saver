#include <iostream>
#include <fstream>
#include <nlohmann/json.hpp>

using json = nlohmann::json;

int main() {
    // 1. Читаем файл (или строку)
    std::ifstream f("data.json");
    json j = json::parse(f);

    // 2. Проходим по массиву branches
    // j["branches"] — это массив (JSON array)
    for (const auto& branch : j["branches"]) {
        // Получаем простые поля. Используем .get<T>() для приведения типов
        int id = branch["id"].get<int>();
        std::string branch_id = branch["branch_id"].get<std::string>();
        std::string created_at = branch["created_at"].get<std::string>();
        std::string expired_type = branch["expired_type"].get<std::string>();

        std::cout << "Branch ID: " << id << ", Type: " << expired_type << std::endl;

        // 3. Проходим по вложенному массиву teams
        // Проверяем, существует ли ключ "teams", чтобы избежать ошибок
        if (branch.contains("teams") && branch["teams"].is_array()) {
            for (const auto& team : branch["teams"]) {
                std::string team_name = team["name"].get<std::string>();
                std::cout << "  Team: " << team_name << std::endl;
            }
        }
    }

    return 0;
}
